{
    // Запуск сайта прямо на GitHub: кнопка «Code → Codespaces → Create codespace on main».
    // Через 2–4 минуты откроется сайт (порт 8080) с базой MariaDB и демо-данными.
    "name": "Puff Drive",
    "build": { "dockerfile": "Dockerfile" },
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {}
    },
    // Xdebug из базового образа на каждом запросе ищет отладчик и тормозит сайт
    "containerEnv": { "XDEBUG_MODE": "off" },
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": { "label": "Сайт Puff Drive", "onAutoForward": "openBrowser" }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "bash .devcontainer/start.sh",
    "customizations": {
        "vscode": {
            "extensions": ["bmewburn.vscode-intelephense-client"]
        }
    }
}
